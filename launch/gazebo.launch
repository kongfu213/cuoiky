<launch>
  <!-- Gazebo Empty World -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find xe)/worlds/empty.world" />
  </include>

  <!-- Static Transform -->
  <node name="tf_footprint_base" pkg="tf" type="static_transform_publisher"
        args="0 0 0 0 0 0 base_link base_footprint 40" />

  <!-- Spawn Robot Model -->
  <node name="spawn_model" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find xe)/urdf/xe.urdf -urdf -model xe"
        output="screen" />

  <!-- Fake Joint Calibration (sửa đúng chuẩn) -->
  <node name="fake_joint_calibration" pkg="rostopic" type="rostopic"
        args="pub -r 10 /calibrated std_msgs/Bool 'data: true'" />

  <!-- Robot State Publisher (dùng Xacro chuẩn ROS) -->
  <param name="robot_description"
         command="$(find xacro)/xacro $(find xe)/urdf/xe.urdf" />
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen" />

  <!-- Load Controllers -->
  <rosparam file="$(find xe)/config/controllers.yaml" command="load"/>
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
        output="screen" args="xe/tt_velocity_controller xe/tp_velocity_controller xe/sp_velocity_controller xe/st_velocity_controller"/>
</launch>
